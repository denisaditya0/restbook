# Line endings are part of the build contract, not a checkout preference.
#
# `scripts/*.sh` run on the Linux and macOS CI runners, where a CRLF `sh`
# script fails on the stray `\r` in every line. The Windows-only wrappers are
# the opposite: `cmd.exe` and PowerShell want CRLF.
#
# `.sh` files in this tree are currently CRLF on a Windows checkout; this file
# is what normalizes them to LF as they are added to the index.
* text=auto

*.rs    text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

*.ps1   text eol=crlf
*.cmd   text eol=crlf

*.ico   binary
*.icns  binary
*.png   binary
